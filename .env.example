# Copy to .env (never commit .env). Every key is optional: without them WiseMouth
# still runs in typed-input / demo mode with rules-only analysis.

# Speech-to-text (enables the microphone)
ASSEMBLYAI_API_KEY=

# LLM refinement: groq | gemini | none. The other provider is used as fallback if its key is set.
LLM_PROVIDER=groq
GROQ_API_KEY=
GEMINI_API_KEY=

# Empty -> local SQLite file (backend/data/wisemouth.db). docker compose sets Postgres automatically.
DATABASE_URL=

# Signs login tokens. Set a long random string (e.g. `openssl rand -hex 32`) or logins reset on every restart.
AUTH_SECRET=

# Backend CORS (production): comma-separated frontend origins, no trailing slash.
# Default "*" is fine locally. On Render set e.g. https://wise-mouth.vercel.app
CORS_ORIGINS=*
# Optional regex for Vercel preview URLs, e.g. https://wise-mouth.*\.vercel\.app
CORS_ORIGIN_REGEX=

# Frontend -> backend URL (set in Vercel to the Render URL, https://..., baked in at build time)
NEXT_PUBLIC_API_URL=http://localhost:8000
