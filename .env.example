# Copy to .env (never commit .env). Every key is optional: without them WiseMouth
# still runs in typed-input / demo mode with rules-only analysis.

# Speech-to-text (enables the microphone)
ASSEMBLYAI_API_KEY=

# LLM refinement: groq | gemini | none. The other provider is used as fallback if its key is set.
LLM_PROVIDER=groq
GROQ_API_KEY=
GEMINI_API_KEY=

# Empty -> local SQLite file (backend/data/wisemouth.db). docker compose sets Postgres automatically.
DATABASE_URL=

# Frontend -> backend URL
NEXT_PUBLIC_API_URL=http://localhost:8000
